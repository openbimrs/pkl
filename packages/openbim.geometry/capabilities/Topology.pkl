/// Topology, validation, conversion, and repair capability identifiers.
module openbim.geometry.capabilities.topology

typealias CapabilityId =
  "openbim.geometry:topology.adjacency"
    | "openbim.geometry:topology.manifold-validation"
    | "openbim.geometry:topology.geometric-validation"
    | "openbim.geometry:tessellation.surface"
    | "openbim.geometry:repair.diagnosis"
    | "openbim.geometry:repair.explicit"
