/// Query and classification capability identifiers.
module openbim.geometry.capabilities.query

typealias CapabilityId =
  "openbim.geometry:distance.minimum"
    | "openbim.geometry:distance.signed"
    | "openbim.geometry:clearance.directional"
    | "openbim.geometry:containment.point-in-solid"
    | "openbim.geometry:intersection.curve-curve"
    | "openbim.geometry:intersection.curve-surface"
    | "openbim.geometry:intersection.surface-surface"
    | "openbim.geometry:intersection.section"
    | "openbim.geometry:projection.point-curve"
    | "openbim.geometry:projection.point-surface"
