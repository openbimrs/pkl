/// Representation capability identifiers.
module openbim.geometry.capabilities.representation

typealias CapabilityId =
  "geometry.representation.mesh.triangle"
    | "geometry.representation.mesh.polygon"
    | "geometry.representation.curve.analytic"
    | "geometry.representation.surface.analytic"
    | "geometry.representation.nurbs.curve"
    | "geometry.representation.nurbs.surface"
    | "geometry.representation.brep.topology"
    | "geometry.representation.brep.exact-result"
    | "geometry.representation.brep.trimmed-analytic"
    | "geometry.representation.set-theoretic-solid"
