/// Representation capability identifiers.
module openbim.geometry.capabilities.representation

typealias CapabilityId =
  "openbim.geometry:representation.mesh.triangle"
    | "openbim.geometry:representation.mesh.polygon"
    | "openbim.geometry:representation.curve.analytic"
    | "openbim.geometry:representation.surface.analytic"
    | "openbim.geometry:representation.nurbs.curve"
    | "openbim.geometry:representation.nurbs.surface"
    | "openbim.geometry:representation.brep.topology"
    | "openbim.geometry:representation.brep.exact-result"
    | "openbim.geometry:representation.brep.trimmed-analytic"
    | "openbim.geometry:representation.set-theoretic-solid"
