/// Construction, Boolean, and editing capability identifiers.
module openbim.geometry.capabilities.operation

typealias CapabilityId =
  "openbim.geometry:boolean.union"
    | "openbim.geometry:boolean.intersection"
    | "openbim.geometry:boolean.difference"
    | "openbim.geometry:boolean.symmetric-difference"
    | "openbim.geometry:construction.extrusion"
    | "openbim.geometry:construction.revolution"
    | "openbim.geometry:construction.sweep"
    | "openbim.geometry:construction.loft"
    | "openbim.geometry:edit.offset"
    | "openbim.geometry:edit.fillet"
    | "openbim.geometry:transform.affine"
