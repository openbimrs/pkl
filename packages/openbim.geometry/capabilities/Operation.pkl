/// Construction, Boolean, and editing capability identifiers.
module openbim.geometry.capabilities.operation

typealias CapabilityId =
  "geometry.boolean.union"
    | "geometry.boolean.intersection"
    | "geometry.boolean.difference"
    | "geometry.boolean.symmetric-difference"
    | "geometry.construction.extrusion"
    | "geometry.construction.revolution"
    | "geometry.construction.sweep"
    | "geometry.construction.loft"
    | "geometry.edit.offset"
    | "geometry.edit.fillet"
    | "geometry.transform.affine"
