/// Example neutral requirement profile for an analytic B-rep model checker.
/// It deliberately refuses a mesh-only or topology-only declaration.
module openbim.geometry.examples.requirements.analyticBrep

import "../../schema/Exactness.pkl" as exactness
import "../../schema/Requirements.pkl" as requirementsSchema

requirements: requirementsSchema.GeometryRequirements = new requirementsSchema.GeometryRequirements {
  id = "org.example.mcs.analytic-brep.v1"
  allOf =
    List(
      new requirementsSchema.CapabilityRequirement {
        capability = "geometry.representation.brep.trimmed-analytic"
        minimumLevel = "full"
        acceptedExactness = List("analytic")
        dimensions = List("3D")
        inputRepresentations = List("brep")
        outputRepresentations = List("brep")
      },
      new requirementsSchema.CapabilityRequirement {
        capability = "geometry.topology.geometric-validation"
        minimumLevel = "full"
        acceptedExactness = List("tolerance-bounded", "exact")
        dimensions = List("3D")
        inputRepresentations = List("brep")
        outputRepresentations = List("brep")
      },
    )
}
