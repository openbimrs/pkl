/// Version-separated IFC structural catalogs derived from canonical ifc-schema artifacts.
amends "pkl:Project"

package {
  name = "openbim.ifc"
  baseUri = "package://openbimrs.github.io/pkl/openbim.ifc"
  version = "0.1.0"
  packageZipUrl =
    "https://github.com/openbimrs/pkl/releases/download/openbim.ifc@\(version)/openbim.ifc@\(version).zip"
  description = "Versioned Apple Pkl contracts for IFC structural schema references."
  authors {
    "OpenBIM.rs contributors <openbimrs@users.noreply.github.com>"
  }
  license = "AGPL-3.0-or-later"
  issueTracker = "https://github.com/openbimrs/pkl/issues"
  sourceCode = "https://github.com/openbimrs/pkl/tree/\(name)@\(version)/packages/openbim.ifc"
  sourceCodeUrlScheme =
    "https://github.com/openbimrs/pkl/blob/\(name)@\(version)/packages/openbim.ifc%{path}#L%{line}-%{endLine}"
  apiTests {
    "tests/ifc.pkl"
  }
  exclude {
    "AGENTS.md"
    "examples/**"
    "provenance/**"
    "tests/**"
  }
}

tests {
  "tests/ifc.pkl"
}
