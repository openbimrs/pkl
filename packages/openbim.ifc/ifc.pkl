/// Neutral, version-explicit references into delta-compressed IFC structural catalogs.
module openbim.ifc

typealias ReleaseId = "IFC2X3_TC1" | "IFC4_ADD2_TC1" | "IFC4X3_ADD2"
typealias LifecycleChangeKind = "introduced" | "deprecated" | "removed" | "renamed" | "replaced"

/// Exact identity and provenance boundary for one bundled IFC schema table.
class Release {
  id: ReleaseId
  label: String
  headerTokens: List<String>(isNotEmpty)
  entityCount: UInt
  typeCount: UInt
  sourceUri: String(startsWith("https://"))
  /// Release-bound IFC identifier. This is domain identity, never package transport.
  externalTypeSystem: String(startsWith("https://"))
  /// Package transport identity for this generated catalog release.
  packageCatalogUri: String(startsWith("package://openbimrs.github.io/pkl/openbim.ifc@0.2.1#/"))
}

/// Physical storage fact: immediate parent and directly declared positional slots only.
class DirectEntityDefinition {
  parent: String?
  attributes: List<String>
}

/// Version-bound entity reference resolved from direct declarations at query time.
class EntityReference {
  release: ReleaseId
  externalTypeSystem: String(startsWith("https://"))
  packageCatalogUri: String(startsWith("package://openbimrs.github.io/pkl/openbim.ifc@0.2.1#/"))
  name: String(matches(Regex(#"^Ifc[A-Za-z0-9_]+$"#)))
  directSupertype: String?
  directAttributes: List<String>
  /// Reconstructed nearest-parent-first ancestry for this exact release.
  supertypes: List<String>
  /// Reconstructed inherited-first Part 21 positional attributes for this exact release.
  attributes: List<String>
}

/// One validated positional attribute on an exact version-bound entity.
class AttributeReference {
  entity: EntityReference
  name: String(entity.attributes.contains(this))
}

/// Cross-release structural history for one canonical entity name.
class EntityEvolution {
  name: String(matches(Regex(#"^Ifc[A-Za-z0-9_]+$"#)))
  definitions: Mapping<ReleaseId, DirectEntityDefinition>(isNotEmpty)
  observedAddedIn: List<ReleaseId>
  observedRemovedIn: List<ReleaseId>
  lifecycleEvidence: List<LifecycleEvidence>
}

/// Normative lifecycle fact with authoritative evidence.
class LifecycleEvidence {
  entity: String(matches(Regex(#"^Ifc[A-Za-z0-9_]+$"#)))
  kind: LifecycleChangeKind
  release: ReleaseId
  sourceUri: String(startsWith("https://"))
  target: String?
}

/// Typed extension boundary only. PSD/QTO occurrences must come from canonical
/// ifc-template-catalog exports and continuity always requires explicit evidence.
class TemplateCatalogExtensionBoundary {
  exporter: "ifc-template-catalog"
  status: "not-bundled"
  occurrenceIdentity: "release-local"
  continuityPolicy: "explicit-evidence-required"
  sourceContract: "version-explicit-guid-bearing-tsv"
}

const templateCatalogExtension = new TemplateCatalogExtensionBoundary {
  exporter = "ifc-template-catalog"
  status = "not-bundled"
  occurrenceIdentity = "release-local"
  continuityPolicy = "explicit-evidence-required"
  sourceContract = "version-explicit-guid-bearing-tsv"
}
