/// Neutral, version-explicit references into delta-compressed IFC structural catalogs.
module openbim.ifc

typealias ReleaseId = "IFC2X3_TC1" | "IFC4_ADD2_TC1" | "IFC4X3_ADD2"
typealias LifecycleChangeKind = "introduced" | "deprecated" | "removed" | "renamed" | "replaced"

/// Exact identity and provenance boundary for one bundled IFC schema table.
class Release {
  id: ReleaseId
  label: String
  headerTokens: List<String>(isNotEmpty)
  entityCount: UInt
  typeCount: UInt
  sourceUri: String(startsWith("https://"))
  /// Release-bound IFC identifier. This is domain identity, never package transport.
  externalTypeSystem: String(startsWith("https://"))
  /// Package transport identity for this generated catalog release.
  packageCatalogUri: String(startsWith("package://openbimrs.github.io/pkl/openbim.ifc@0.3.0#/"))
}

/// Physical storage fact: immediate parent and directly declared positional slots only.
class DirectEntityDefinition {
  parent: String?
  attributes: List<String>
}

/// Version-bound entity reference resolved from direct declarations at query time.
class EntityReference {
  release: ReleaseId
  externalTypeSystem: String(startsWith("https://"))
  packageCatalogUri: String(startsWith("package://openbimrs.github.io/pkl/openbim.ifc@0.3.0#/"))
  name: String(matches(Regex(#"^Ifc[A-Za-z0-9_]+$"#)))
  directSupertype: String?
  directAttributes: List<String>
  /// Reconstructed nearest-parent-first ancestry for this exact release.
  supertypes: List<String>
  /// Reconstructed inherited-first Part 21 positional attributes for this exact release.
  attributes: List<String>
}

/// One validated positional attribute on an exact version-bound entity.
class AttributeReference {
  entity: EntityReference
  name: String(entity.attributes.contains(this))
}

/// Cross-release structural history for one canonical entity name.
class EntityEvolution {
  name: String(matches(Regex(#"^Ifc[A-Za-z0-9_]+$"#)))
  definitions: Mapping<ReleaseId, DirectEntityDefinition>(isNotEmpty)
  observedAddedIn: List<ReleaseId>
  observedRemovedIn: List<ReleaseId>
  lifecycleEvidence: List<LifecycleEvidence>
}

/// Normative lifecycle fact with authoritative evidence.
class LifecycleEvidence {
  entity: String(matches(Regex(#"^Ifc[A-Za-z0-9_]+$"#)))
  kind: LifecycleChangeKind
  release: ReleaseId
  sourceUri: String(startsWith("https://"))
  target: String?
}

typealias TemplateSetKind = "psd" | "qto"
typealias TemplateMemberKind =
  "single"
    | "bounded"
    | "enumerated"
    | "list"
    | "reference"
    | "table"
    | "complex"
    | "length"
    | "area"
    | "volume"
    | "count"
    | "weight"
    | "time"

/// One exact release applicability clause. Entity and predefined type remain paired.
class TemplateApplicability {
  entity: String(matches(Regex(#"^Ifc[A-Za-z0-9_]+$"#)))
  predefinedType: String?
  includesSubtypes: Boolean
}

/// One member as published for one release-local set occurrence.
class DirectTemplateMemberDefinition {
  sourceGuid: String?
  kind: TemplateMemberKind
  valueType: String
  unitType: String?
}

/// Set semantics as published for one exact release. Source-file provenance is
/// stored independently so unchanged semantics can be shared across snapshots.
class DirectTemplateSetDefinition {
  kind: TemplateSetKind
  sourceGuid: String?
  templateType: String
  applicability: List<TemplateApplicability>
  members: Mapping<String, DirectTemplateMemberDefinition>(isNotEmpty)
}

class TemplateSourceProvenance {
  path: String(isNotEmpty)
  sha256: String(matches(Regex(#"^[0-9a-f]{64}$"#)))
}

/// Exact inventory and aggregate provenance for one official catalog snapshot.
class TemplateCatalogRelease {
  release: Release
  sourceUri: String(startsWith("https://github.com/openbimrs/ifc/blob/"))
  sourceSha256: String(matches(Regex(#"^[0-9a-f]{64}$"#)))
  sourceDigest: String(matches(Regex(#"^[0-9a-f]{64}$"#)))
  exporterCommit: String(matches(Regex(#"^[0-9a-f]{40}$"#)))
  setCount: UInt
  propertySetCount: UInt
  quantitySetCount: UInt
  memberCount: UInt
  rowCount: UInt
}

/// Release-local official PSD/QTO set reference.
class TemplateSetReference {
  release: ReleaseId
  externalTypeSystem: String(startsWith("https://"))
  packageCatalogUri: String(startsWith("package://openbimrs.github.io/pkl/openbim.ifc@0.3.0#/"))
  kind: TemplateSetKind
  name: String(matches(Regex(#"^(Pset|Qto)_[A-Za-z0-9_]+$"#)))
  sourceGuid: String?
  templateType: String
  applicability: List<TemplateApplicability>
  members: Mapping<String, DirectTemplateMemberDefinition>(isNotEmpty)
  source: TemplateSourceProvenance
}

/// Release-local member reference. `path` remains scoped by its owning set.
class TemplateMemberReference {
  templateSet: TemplateSetReference
  release: ReleaseId
  externalTypeSystem: String(startsWith("https://"))
  packageCatalogUri: String(startsWith("package://openbimrs.github.io/pkl/openbim.ifc@0.3.0#/"))
  path: String(templateSet.members.containsKey(this))
  sourceGuid: String?
  kind: TemplateMemberKind
  valueType: String
  unitType: String?
}

/// Explicit continuity evidence. This list stays empty until a sourced mapping
/// says two release-local occurrences are the same domain identity.
class TemplateContinuityEvidence {
  kind: "authoritative-mapping"
  setName: String(matches(Regex(#"^(Pset|Qto)_[A-Za-z0-9_]+$"#)))
  memberPath: String?
  fromRelease: ReleaseId
  toRelease: ReleaseId
  sourceUri: String(startsWith("https://"))
  sourceGuid: String?
}

/// Same-name observations across pinned snapshots, not an inferred continuity claim.
class TemplateSetEvolution {
  name: String(matches(Regex(#"^(Pset|Qto)_[A-Za-z0-9_]+$"#)))
  definitions: Mapping<ReleaseId, DirectTemplateSetDefinition>(isNotEmpty)
  observedAddedIn: List<ReleaseId>
  observedRemovedIn: List<ReleaseId>
  observedChangedIn: List<ReleaseId>
  continuityEvidence: List<TemplateContinuityEvidence>
}

/// Same set-scoped member-path observations across pinned snapshots.
class TemplateMemberEvolution {
  setName: String(matches(Regex(#"^(Pset|Qto)_[A-Za-z0-9_]+$"#)))
  path: String(isNotEmpty)
  definitions: Mapping<ReleaseId, DirectTemplateMemberDefinition>(isNotEmpty)
  observedAddedIn: List<ReleaseId>
  observedRemovedIn: List<ReleaseId>
  observedChangedIn: List<ReleaseId>
  continuityEvidence: List<TemplateContinuityEvidence>
}

/// Bundled catalog boundary. Occurrences remain release-local and continuity
/// still requires evidence even when source GUIDs happen to match.
class TemplateCatalogExtensionBoundary {
  exporter: "ifc-template-catalog"
  status: "bundled"
  occurrenceIdentity: "release-local"
  continuityPolicy: "explicit-evidence-required"
  sourceContract: "version-explicit-guid-bearing-tsv"
}

const templateCatalogExtension = new TemplateCatalogExtensionBoundary {
  exporter = "ifc-template-catalog"
  status = "bundled"
  occurrenceIdentity = "release-local"
  continuityPolicy = "explicit-evidence-required"
  sourceContract = "version-explicit-guid-bearing-tsv"
}
