/// ISO 7817-3 / EN 17412-3 Level of Information Need contracts for Apple Pkl.
amends "pkl:Project"

package {
  name = "openbim.loin"
  baseUri = "package://openbimrs.github.io/pkl/openbim.loin"
  version = "0.1.0"
  packageZipUrl =
    "https://github.com/openbimrs/pkl/releases/download/openbim.loin@\(version)/openbim.loin@\(version).zip"
  description = "Pure Apple Pkl contracts for openBIM Level of Information Need."
  authors {
    "OpenBIM.rs contributors <openbimrs@users.noreply.github.com>"
  }
  license = "AGPL-3.0-or-later"
  issueTracker = "https://github.com/openbimrs/pkl/issues"
  sourceCode = "https://github.com/openbimrs/pkl/tree/\(name)@\(version)/packages/openbim.loin"
  sourceCodeUrlScheme =
    "https://github.com/openbimrs/pkl/blob/\(name)@\(version)/packages/openbim.loin%{path}#L%{line}-%{endLine}"
  apiTests {
    "tests/loin.pkl"
  }
  exclude {
    "AGENTS.md"
    "examples/**"
    "tests/**"
  }
}

tests {
  "tests/loin.pkl"
}
